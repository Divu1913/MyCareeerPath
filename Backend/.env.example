# Project Settings
PROJECT_NAME="FastAPI MongoDB Career Platform"
VERSION="1.0.0"
API_V1_STR="/api"

# JWT Security
# Generate with: openssl rand -hex 32
SECRET_KEY="your_secret_key_here_replace_me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Connection
# Local (docker-compose default): "mongodb://root:example@localhost:27017"
# Atlas: "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>"
MONGODB_URL="your_mongodb_url_here"
DATABASE_NAME="career_path_db"
MIN_POOL_SIZE=10
MAX_POOL_SIZE=100

# CORS — list of allowed origins (JSON array string)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://localhost:5173"]'

# Google Gemini AI Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Isolated administrator authentication. ADMIN_PASSWORD_HASH must be a bcrypt
# hash (never the plaintext password). ADMIN_USERNAME is optional.
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
ADMIN_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL="http://localhost:5173"

# Optional SMTP relay used to dispatch administrator password-reset links.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
# SMTP_USER may be used instead of SMTP_USERNAME.
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="MyCareerPath Admin"
SMTP_USE_TLS=true

# Optional candidate interview-notification SMS providers (configure either).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# TWILIO_PHONE_NUMBER may be used instead of TWILIO_FROM_NUMBER.
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID=""
